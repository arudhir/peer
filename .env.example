# Environment Configuration for PICA Viewer
# Copy this to .env and update values for your environment

# S3 Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=pb-ome-tiffs
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# Cache
CACHE_ROOT_PATH=~/.pica_cache
CACHE_MAX_SIZE_GB=50

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Feature Flags
USE_ZARR=true
ENABLE_AUTH=false

# Logging
LOG_LEVEL=INFO
